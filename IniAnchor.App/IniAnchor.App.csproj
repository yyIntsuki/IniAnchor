<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>IniAnchor.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- Required by the CsWinRT source generator for the attributes in WinRTExposedTypes.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Unpackaged deployment (no MSIX, no installer) so the app can be published as a
      near-single, portable .exe and just double-clicked - see README.md "Publishing a
      standalone .exe". WindowsAppSDKSelfContained + SelfContained bundle the Windows App
      SDK and .NET runtime into the publish output, so the target machine needs neither
      installed.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IniAnchor.Core\IniAnchor.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Publish Properties - the single source of truth for these (the .pubxml profiles must not
    override them). Trimming removes unused .NET code from the self-contained publish.
    ReadyToRun is off on purpose: it speeds up startup slightly but roughly doubles the size
    of the managed assemblies, and small size is the goal for this portable app.
  -->
  <PropertyGroup>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <!--
      Compresses everything bundled inside the single-file .exe. Costs a little startup time:
      .NET assemblies are decompressed in memory on each launch (a fraction of a second here),
      native DLLs are extracted once per build to %TEMP%\.net\IniAnchor.App\ and reused.
    -->
    <EnableCompressionInSingleFile>True</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    Exclude unused Windows App SDK features from the publish output (~55 MB).
    The Windows App SDK ships its AI/ML stack (ONNX Runtime, DirectML, Windows AI APIs),
    Search, Widgets and Workloads with every self-contained app. IniAnchor uses none of them,
    and trimming can't remove them because they're native DLLs, not .NET code. Nothing loads
    these unless the app calls those APIs, so leaving them out is safe.
    If a Windows App SDK update makes the publish size jump again, check the new file names
    in the build output and extend this pattern. Each excluded file is listed in the publish
    output ("Excluded unused Windows App SDK file: ...").
  -->
  <PropertyGroup>
    <IniAnchorExcludedFilesPattern>(?i)^(onnxruntime\.dll|DirectML\.dll|Microsoft\.ML\.OnnxRuntime\.dll|NPUDetect\.dll|PerceptiveStreaming\.dll|Microsoft\.Asg\..*|Microsoft\.Windows\.AI\..*|Microsoft\.Windows\.Search\..*|Microsoft\.Windows\.Widgets\..*|Microsoft\.Windows\.Workloads\..*|workloads\..*json)$</IniAnchorExcludedFilesPattern>
  </PropertyGroup>

  <Target Name="ExcludeUnusedWindowsAppSdkFeatures" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_IniAnchorExcludedFile Include="@(ResolvedFileToPublish)"
                              Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(IniAnchorExcludedFilesPattern)'))" />
      <ResolvedFileToPublish Remove="@(_IniAnchorExcludedFile)" />
    </ItemGroup>
    <Message Importance="high" Text="Excluded unused Windows App SDK file: %(_IniAnchorExcludedFile.Filename)%(_IniAnchorExcludedFile.Extension)" />
  </Target>
</Project>