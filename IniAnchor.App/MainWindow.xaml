<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IniAnchor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IniAnchor.App"
    xmlns:vm="using:IniAnchor.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="IniAnchor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- Shared by all lists: the row fills the whole item (no default padding), so
                 hovering anywhere on it shows its buttons, and the buttons sit at the right edge. -->
            <Style x:Key="FullRowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: the app draws into the title bar area (ExtendsContentIntoTitleBar
             in code-behind), so it has the same Mica background as the rest of the window
             instead of a separate white bar. This row is the drag region; the system still
             draws minimize/maximize/close on the right. -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0">
            <TextBlock Text="IniAnchor"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,0,16,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: folders, and at the bottom the apply buttons + status line (kept here,
                 not in a full-width bottom bar, so the keys panel can use the full window height). -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="New folder..." Click="NewFolderButton_Click" />
                </StackPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Folders}"
                          SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource FullRowItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderViewModel">
                            <Grid Padding="12,0,4,0" ColumnSpacing="4"
                                  Background="Transparent"
                                  PointerEntered="Row_PointerEntered"
                                  PointerExited="Row_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Name, Mode=OneWay}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2"
                                        Width="32" Height="32" Padding="0"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ShowActions, Mode=OneWay}"
                                        Click="RenameFolderButton_Click"
                                        ToolTipService.ToolTip="Rename folder">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                </Button>
                                <!-- Delete is always the rightmost button -->
                                <Button Grid.Column="3"
                                        Width="32" Height="32" Padding="0"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ShowActions, Mode=OneWay}"
                                        Click="DeleteFolderButton_Click"
                                        ToolTipService.ToolTip="Delete folder and its entries">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Status line + apply buttons in one row. The status line sits above the
                     buttons (so the buttons stay at the bottom) and is collapsed while empty,
                     so it leaves no gap. -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <!-- Status line: apply summary or errors -->
                    <TextBlock Text="{x:Bind ViewModel.LastApplyMessage, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasLastApplyMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               MaxLines="4"
                               TextTrimming="CharacterEllipsis"
                               Opacity="0.8" />

                    <!-- "Apply folder" gets the width its text needs (an even split of the 200px
                         sidebar cut it off); "Apply all" fills the rest. -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Apply folder"
                                IsEnabled="{x:Bind ViewModel.HasUserFolderSelected, Mode=OneWay}"
                                Click="ApplyFolderButton_Click"
                                ToolTipService.ToolTip="Apply only the selected folder's entries" />
                        <Button Grid.Column="1"
                                Content="Apply all"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ApplyAllButton_Click"
                                ToolTipService.ToolTip="Apply every entry in every folder" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Content area: the file list, with the keys panel flying in over it from the right. -->
            <Grid x:Name="ContentArea" Grid.Column="1">

                <!-- File entries of the selected folder. Same background and padding as the
                     keys panel, so both look alike and line up exactly when it slides over. -->
                <Border Padding="12"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddFileButton" Content="Add ini file..." Click="AddFileButton_Click" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{x:Bind ViewModel.VisibleFiles}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource FullRowItemStyle}"
                                  Background="Transparent"
                                  Tapped="List_Tapped"
                                  KeyDown="List_KeyDown">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:WatchedFileViewModel">
                                    <!-- Path left, folder name (only in "All") right-aligned on the same line.
                                         Button columns have fixed widths so nothing shifts on hover. -->
                                    <Grid Padding="12,0,4,0" ColumnSpacing="8"
                                          Background="Transparent"
                                          PointerEntered="Row_PointerEntered"
                                          PointerExited="Row_PointerExited">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind FilePath}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind FolderName, Mode=OneWay}"
                                                   Visibility="{x:Bind ShowFolderName, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.6" />
                                        <Button Grid.Column="2"
                                                Width="32" Height="32" Padding="0"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsHovered, Mode=OneWay}"
                                                Click="OpenFileButton_Click"
                                                ToolTipService.ToolTip="Open in default editor">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        </Button>
                                        <!-- Remove is always the rightmost button -->
                                        <Button Grid.Column="3"
                                                Width="32" Height="32" Padding="0"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsHovered, Mode=OneWay}"
                                                Click="RemoveFileButton_Click"
                                                ToolTipService.ToolTip="Remove from list">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="No files yet. Click 'Add ini file...' to get started."
                                   Visibility="{x:Bind ViewModel.HasNoVisibleFiles, Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"
                                   Opacity="0.6" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
                </Border>

                <!-- Keys panel: covers the file list while an entry is selected. Shown/hidden
                     (with a slide animation) by code-behind when HasSelectedFile changes;
                     closing it just clears the selected entry. Opaque background so the file
                     list doesn't show through; square corners, since rounded ones let the
                     "Add ini file..." button underneath peek through at the top-left. -->
                <Border x:Name="KeysPanel"
                        Visibility="Collapsed"
                        Padding="12"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="KeysPanelTransform" />
                    </Border.RenderTransform>

                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Add key | ...entry drop-down... | close -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="AddKeyButton" Content="Add key..."
                                    IsEnabled="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"
                                    Click="AddKeyButton_Click" />

                            <!-- Switch between the folder's entries without closing the panel.
                                 One line per entry (path left, folder name right), so the header
                                 keeps the same height. Stretch so the folder name can right-align. -->
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.VisibleFiles}"
                                      SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Switch ini file entry">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WatchedFileViewModel">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FilePath}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FolderName, Mode=OneWay}"
                                                       Visibility="{x:Bind ShowFolderName, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.6" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="2"
                                    Width="32" Height="32" Padding="0"
                                    Click="CloseKeysPanelButton_Click"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListView ItemsSource="{x:Bind ViewModel.SelectedFileKeys, Mode=OneWay}"
                                      ItemContainerStyle="{StaticResource FullRowItemStyle}"
                                      Background="Transparent"
                                      Tapped="List_Tapped"
                                      KeyDown="List_KeyDown">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WatchedKeyViewModel">
                                        <!-- Key name on the left; everything else right-aligned. Name and
                                             value box split the flexible space equally (the box gets about
                                             half the row). Icon and button columns have fixed widths, so
                                             value boxes line up across rows and don't shift on hover. -->
                                        <Grid Padding="12,0,4,0" ColumnSpacing="8"
                                              Background="Transparent"
                                              PointerEntered="Row_PointerEntered"
                                              PointerExited="Row_PointerExited">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Dimmed with "; " in front while the key is turned off (commented out) -->
                                            <TextBlock Text="{x:Bind DisplayLabel, Mode=OneWay}"
                                                       Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBox Grid.Column="1"
                                                     Text="{x:Bind DesiredValue, Mode=TwoWay}"
                                                     Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Center"
                                                     LostFocus="DesiredValueBox_LostFocus" />
                                            <!-- Status on disk: one icon, name on hover. Only one is visible at a time. -->
                                            <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE73E;" FontSize="16"
                                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                          Visibility="{x:Bind IsUnique, Mode=OneWay}"
                                                          ToolTipService.ToolTip="Unique" />
                                                <FontIcon Glyph="&#xE711;" FontSize="16"
                                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                          Visibility="{x:Bind IsNotFound, Mode=OneWay}"
                                                          ToolTipService.ToolTip="Not Found" />
                                                <FontIcon Glyph="&#xE7BA;" FontSize="16"
                                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                          Visibility="{x:Bind IsDuplicate, Mode=OneWay}"
                                                          ToolTipService.ToolTip="Duplicate" />
                                            </Grid>
                                            <!-- Last Apply hit a file error; hover shows the actual message -->
                                            <FontIcon Grid.Column="3"
                                                      Glyph="&#xE783;" FontSize="16"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                      VerticalAlignment="Center"
                                                      Visibility="{x:Bind HasApplyError, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{x:Bind LastApplyError, Mode=OneWay}" />
                                            <!-- Turn off (comment out) / turn on; the icon shows what a click will do -->
                                            <Button Grid.Column="4"
                                                    Width="32" Height="32" Padding="0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsHovered, Mode=OneWay}"
                                                    Click="ToggleKeyCommentedOutButton_Click"
                                                    ToolTipService.ToolTip="{x:Bind ToggleToolTip, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind ToggleGlyph, Mode=OneWay}" FontSize="14" />
                                            </Button>
                                            <Button Grid.Column="5"
                                                    Width="32" Height="32" Padding="0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind ShowRevert, Mode=OneWay}"
                                                    Click="RevertKeyButton_Click"
                                                    ToolTipService.ToolTip="{x:Bind RevertToolTip}">
                                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                            </Button>
                                            <!-- Remove is always the rightmost button -->
                                            <Button Grid.Column="6"
                                                    Width="32" Height="32" Padding="0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsHovered, Mode=OneWay}"
                                                    Click="RemoveKeyButton_Click"
                                                    ToolTipService.ToolTip="Stop watching this key">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Text="{x:Bind ViewModel.KeysEmptyMessage, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.ShowKeysEmptyMessage, Mode=OneWay}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"
                                       Opacity="0.6" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
