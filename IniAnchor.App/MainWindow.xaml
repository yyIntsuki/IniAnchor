<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IniAnchor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IniAnchor.App"
    xmlns:vm="using:IniAnchor.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="IniAnchor.App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" RowSpacing="12">
        <Grid.Resources>
            <!-- Shared by both lists: the row fills the whole item (no default padding), so
                 hovering anywhere on it shows its buttons, and the buttons sit at the right edge. -->
            <Style x:Key="FullRowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: watched files -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddFileButton" Content="Add ini file..." Click="AddFileButton_Click" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListView ItemsSource="{x:Bind ViewModel.WatchedFiles}"
                              SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource FullRowItemStyle}"
                              Background="Transparent"
                              Tapped="List_Tapped"
                              KeyDown="List_KeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WatchedFileViewModel">
                                <Grid Padding="12,0,4,0" ColumnSpacing="4"
                                      Background="Transparent"
                                      PointerEntered="Row_PointerEntered"
                                      PointerExited="Row_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DisplayText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Width="32" Height="32" Padding="0"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsHovered, Mode=OneWay}"
                                            Click="OpenFileButton_Click"
                                            ToolTipService.ToolTip="Open in default editor">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    </Button>
                                    <!-- Remove is always the rightmost button -->
                                    <Button Grid.Column="2"
                                            Width="32" Height="32" Padding="0"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsHovered, Mode=OneWay}"
                                            Click="RemoveFileButton_Click"
                                            ToolTipService.ToolTip="Remove from list">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="No files yet. Click 'Add ini file...' to get started."
                               Visibility="{x:Bind ViewModel.HasNoWatchedFiles, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"
                               Opacity="0.6" IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <!-- Right: watched keys for the selected file -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddKeyButton" Content="Add key..."
                            IsEnabled="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"
                            Click="AddKeyButton_Click" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListView ItemsSource="{x:Bind ViewModel.SelectedFileKeys, Mode=OneWay}"
                              ItemContainerStyle="{StaticResource FullRowItemStyle}"
                              Background="Transparent"
                              Tapped="List_Tapped"
                              KeyDown="List_KeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WatchedKeyViewModel">
                                <Grid Padding="12,0,4,0" ColumnSpacing="8"
                                      Background="Transparent"
                                      PointerEntered="Row_PointerEntered"
                                      PointerExited="Row_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DisplayLabel}"
                                               VerticalAlignment="Center"
                                               MinWidth="160"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind DesiredValue, Mode=TwoWay}"
                                             Width="160"
                                             VerticalAlignment="Center"
                                             LostFocus="DesiredValueBox_LostFocus" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Status, Mode=OneWay}"
                                               Opacity="0.6" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="⚠"
                                               Foreground="Red"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind HasApplyError, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind LastApplyError, Mode=OneWay}" />
                                    <!-- Column 4 is empty space, pushing remove to the right edge -->
                                    <Button Grid.Column="5"
                                            Width="32" Height="32" Padding="0"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsHovered, Mode=OneWay}"
                                            Click="RemoveKeyButton_Click"
                                            ToolTipService.ToolTip="Stop watching this key">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.KeysEmptyMessage, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ShowKeysEmptyMessage, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"
                               Opacity="0.6" IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom: single global Apply, per the app's whole point -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Content="Apply"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ApplyButton_Click" />
            <TextBlock Text="{x:Bind ViewModel.LastApplyMessage, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Opacity="0.8" />
        </StackPanel>
    </Grid>
</Window>
