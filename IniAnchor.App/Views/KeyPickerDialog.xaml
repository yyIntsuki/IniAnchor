<ContentDialog
    x:Class="IniAnchor.App.Views.KeyPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:IniAnchor.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pick a key to watch"
    PrimaryButtonText="Add"
    IsPrimaryButtonEnabled="False"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid RowSpacing="8" MinWidth="420" MinHeight="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox"
                 Grid.Row="0"
                 PlaceholderText="Search section or key..."
                 TextChanged="SearchBox_TextChanged" />

        <ListView x:Name="ResultsList"
                  Grid.Row="1"
                  SelectionChanged="ResultsList_SelectionChanged"
                  DoubleTapped="ResultsList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:IniKeyPickItem">
                    <TextBlock Text="{x:Bind DisplayLabel}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
